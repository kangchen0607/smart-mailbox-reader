# Copier ce fichier en .env et le remplir. Le .env n'est jamais commité.
IMAP_HOST=imap.free.fr
IMAP_PORT=993
IMAP_USER=votre_identifiant@free.fr
IMAP_PASSWORD=votre_mot_de_passe

# Dossiers de destination (créés automatiquement s'ils manquent)
FOLDER_IMPORTANT=Important
FOLDER_LESS_IMPORTANT=Moins important

# Nombre maximum de messages traités par exécution
MAX_MESSAGES=50
